# thlntfs per-session PF anchor — loaded as direct child com.apple/thlntfs-{{SESSION}}.
# The NFS client initiates TCP/UDP traffic to fixed NFS (2049) and mountd (32767) ports; PF state
# permits replies. Every other IPv4 packet entering or leaving this one vmnet /30 is dropped.
pass out quick on {{INTERFACE}} inet proto { tcp, udp } from {{SUBNET}} to {{SUBNET}} port { 2049, 32767 } keep state label "thlntfs-{{SESSION}}-nfs"
block drop quick on {{INTERFACE}} inet from {{SUBNET}} to any label "thlntfs-{{SESSION}}-egress-block"
block drop quick on {{INTERFACE}} inet from any to {{SUBNET}} label "thlntfs-{{SESSION}}-ingress-block"
